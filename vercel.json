{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/docs", "destination": "/api/index" }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "includeFiles": "{crease,crease_api,sql}/**",
      "excludeFiles": "{tests,bench,reports,samples,.venv}/**"
    }
  }
}
