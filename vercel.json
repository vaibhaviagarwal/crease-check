{
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?__path=/api/:path*" },
    { "source": "/docs", "destination": "/api/index?__path=/docs" }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "includeFiles": "{crease,crease_api,sql}/**",
      "excludeFiles": "{tests,bench,reports,samples,.venv}/**"
    }
  }
}
